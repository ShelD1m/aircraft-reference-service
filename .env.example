NSI_HTTP_PORT=8082
# Enable after AUTH implements verify/permissions/check.
AUTH_ENABLED=false
AUTH_BASE_URL=http://host.docker.internal:8081
AUTH_SERVICE_TOKEN=
# Unauthenticated CORE compatibility endpoint; restrict network access externally.
CORE_REQUIRE_AUTH=false
CORE_PROCEDURE_CODE=PRE_DEPARTURE
CORE_MINUTE_POLICY=exact
CORE_CACHE_TTL_SECONDS=300
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
KAFKA_AUDIT_TOPIC=hcc.audit.events.v1
NSI_DB_NAME=nsi
NSI_DB_USER=nsi
NSI_DB_PASSWORD=nsi_demo_password
NSI_DB_PORT=5433
KAFKA_OUTBOX_BATCH_SIZE=20
KAFKA_OUTBOX_POLL_INTERVAL_MS=1000
KAFKA_SEND_TIMEOUT_MS=5000
